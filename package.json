{
  "name": "mnt-rms",
  "version": "0.1.0",
  "description": "Minimal Remotion verification repository",
  "packageManager": "bun@1.3.14",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/index.ts help",
    "video:compositions": "bun src/index.ts compositions manatee-float",
    "video:render": "bun src/index.ts render manatee-float",
    "video:studio": "bun src/index.ts studio manatee-float",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && bun run typecheck",
    "fix": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@remotion/cli": "4.0.454",
    "@remotion/media-parser": "4.0.454",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/bun": "1.3.14",
    "husky": "9.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.454",
    "typescript": "6.0.3"
  }
}
