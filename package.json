{
  "name": "bun-spt",
  "version": "0.1.0",
  "description": "Bun and TypeScript template repository for scripts",
  "packageManager": "bun@1.3.14",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && bun run typecheck",
    "fix": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.14",
    "husky": "9.1.7",
    "typescript": "6.0.3"
  }
}
